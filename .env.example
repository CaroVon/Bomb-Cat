# ===== 前端（Vite 读取） =====
# Supabase 项目 URL 与 anon key（不填则为纯游客模式）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 游戏服务器地址（默认按当前页面协议推导 ws(s)://hostname:2567）
# VITE_GAME_URL=ws://localhost:2567

# ===== 后端（复制到 server/.env） =====
# Supabase JWT 验证，二选一；都不配则放行游客
SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=
# 游戏服务器端口（默认 2567）
# PORT=2567
