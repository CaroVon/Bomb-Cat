# ===== 前端（Vite 读取） =====
# Supabase 项目 URL 与 anon key（不填则为纯游客模式）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 游戏服务器地址（默认按当前页面协议推导 ws(s)://hostname:2567）
# VITE_GAME_URL=ws://localhost:2567

# ===== 后端（复制到 server/.env） =====
# Supabase JWT 验证，二选一；都不配则放行游客
SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=
# 游戏服务器端口（默认 2567）
# PORT=2567

# ===== 资产生图(脚本 gen-assets 读取) =====
# Provider 选择:minimax | openai | replicate | zhipu | aliyun | custom
PROVIDER=minimax

# 通用写法(适合 minimax / 自部署),按平台文档改 URL/字段
# ⚠ 文档说 api.minimax.io,但实测能用的是 api.minimaxi.com
MINIMAX_IMAGE_URL=https://api.minimaxi.com/v1/image_generation
MINIMAX_API_KEY=
# MINIMAX_IMAGE_MODEL=image-01

# OpenAI DALL-E 3
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=dall-e-3

# Replicate(SDXL / Flux)
# REPLICATE_API_KEY=
# REPLICATE_MODEL_VERSION=（model version hash,从 replicate.com 页面复制）

# 智谱 CogView
# ZHIPU_API_KEY=
# ZHIPU_IMAGE_MODEL=cogview-3

# 阿里通义 Wanxiang
# ALIYUN_API_KEY=
# ALIYUN_IMAGE_MODEL=wanx-v1

# 自定义 POST 接口(发 { prompt, negative, w, h },回 { b64 } 或 { url })
# GENERATE_IMAGE_URL=
# GENERATE_IMAGE_AUTH=Bearer xxx

